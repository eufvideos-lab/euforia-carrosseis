              "value": "2022-06-28"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ properties: { 'Status': { select: { name: 'Erro na postagem' } }, 'Erro': { rich_text: [ { text: { content: String($json.erro || $json.error?.message || $json.error || 'Erro desconhecido').slice(0, 1900) } } ] } } }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "TROCAR",
          "name": "Notion Euforia"
        }
      }
    },
