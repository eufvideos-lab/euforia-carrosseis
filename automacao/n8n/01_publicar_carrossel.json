    {
      "id": "ee528366-bdda-467e-8fd3-7a0165f44273",
      "name": "Notion: buscar post agendado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.notion.com/v1/databases/{{ $json.notionDb }}/query",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2022-06-28"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filter: { and: [ { property: 'Status', select: { equals: 'Agendado' } }, { property: 'Data de postagem', date: { on_or_before: $now.toISO() } } ] }, sorts: [ { property: 'Data de postagem', direction: 'ascending' } ], page_size: 1 }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "TROCAR",
          "name": "Notion Euforia"
        }
      }
    },
    {
      "id": "30325834-ce78-4a22-ba1e-544c404631cf",
      "name": "Preparar post",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "// Pega o primeiro post agendado que já passou do horário e monta a lista de artes (JPEG no GitHub)\nconst res = $input.first().json;\nif (!res.results || res.results.length === 0) return []; // nada pra postar agora\nconst page = res.results[0];\nconst p = page.properties;\nconst txt = (rt) => (rt || []).map(t => t.plain_text).join('');\nconst pasta = txt(p['Pasta das artes']?.rich_text).trim().replace(/^\\/+|\\/+$/g, '');\nconst total = p['Slides']?.number || 0;\nconst legenda = txt(p['Legenda']?.rich_text);\nconst base = $('Config').first().json.githubBase;\nlet erro = '';\nif (!pasta) erro = 'Campo \"Pasta das artes\" vazio';\nelse if (total < 2 || total > 10) erro = 'Campo \"Slides\" precisa ser entre 2 e 10 (carrossel)';\nelse if (!legenda) erro = 'Campo \"Legenda\" vazio';\nif (legenda.length > 2200) erro = 'Legenda passa de 2.200 caracteres';\nconst urls = [];\nfor (let i = 1; i <= total; i++) urls.push(`${base}${pasta}/slide_${String(i).padStart(2, '0')}.jpg`);\nreturn [{ json: { pageId: page.id, titulo: txt(p['Título']?.title), legenda, urls, erro } }];"
      }
    },
    {
      "id": "b775fa8f-2a93-4519-a0f4-c704cca8cdc5",
      "name": "Tem erro?",
      "type": "n8n-nodes-base.if",
