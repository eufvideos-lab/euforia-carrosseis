      "name": "Juntar IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        400
      ],
      "parameters": {
        "jsCode": "const ids = $input.all().map(i => i.json.id).filter(Boolean);\nconst post = $('Preparar post').first().json;\nif (ids.length !== post.urls.length) return [{ json: { erro: `Só ${ids.length} de ${post.urls.length} artes foram aceitas pelo Instagram` } }];\nreturn [{ json: { children: ids.join(','), legenda: post.legenda } }];"
      }
