      "parameters": {
        "method": "POST",
        "url": "=https://graph.instagram.com/v23.0/{{ $('Config').first().json.igUserId }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ recipient: { comment_id: $json.commentId }, message: { text: `Oi, @${$json.username}! Aqui é do Grupo Euforia 🧡\\n\\nVi que você comentou ${$json.palavra}. Segue o link pra agendar o seu Raio-X gratuito de 15 minutos com os nossos consultores:\\n\\n${$('Config').first().json.linkAgenda}\\n\\nÉ exclusivo para profissionais que já têm resultado no offline e querem escalar no digital.` } }) }}"
      },
      "credentials": {
        "httpQueryAuth": {
          "id": "TROCAR",
          "name": "Instagram Euforia"
        }
      },
      "onError": "continueRegularOutput"
    },
