    {
      "id": "7ab54b6e-2f5c-46a2-b8c8-9edbfbaa8af0",
      "name": "Posts dos últimos 7 dias",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "// A resposta privada (DM) só pode ser enviada até 7 dias depois do comentário\nconst limite = Date.now() - 7 * 24 * 3600 * 1000;\nconst data = $input.first().json.data || [];\nreturn data.filter(m => new Date(m.timestamp).getTime() > limite)\n  .map(m => {\n    const k = (m.caption || '').match(/Comente\\s+([A-Za-zÀ-ÿ0-9\\-]{3,})/i);\n    return { json: { mediaId: m.id, palavra: k ? k[1].toUpperCase() : '' } };\n  });"
      }
    },
    {
      "id": "4595458f-e90f-41dd-b09b-091ca3d412b1",
      "name": "IG: comentários do post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://graph.instagram.com/v23.0/{{ $json.mediaId }}/comments",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,text,username,timestamp,hidden"
            },
            {
              "name": "limit",
              "value": "50"
            }
          ]
        }
      },
      "credentials": {
        "httpQueryAuth": {
          "id": "TROCAR",
          "name": "Instagram Euforia"
        }
      }
    },
    {
      "id": "067f4ade-1cf5-41b3-9cb7-606f3207bcc3",
      "name": "Classificar comentários",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "jsCode": "// Decide o que fazer com cada comentário novo. Guarda os já tratados pra não repetir.\nconst memoria = $getWorkflowStaticData('global');\nmemoria.tratados = memoria.tratados || {};\nconst cfg = $('Config').first().json;\nconst posts = $('Posts dos últimos 7 dias').all();\n// ignora acento, espaço e hífen: \"raio x\", \"Raio-X\" e \"RAIOX\" contam igual\nconst norm = (s) => (s || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toUpperCase().replace(/[^A-Z0-9]/g, '');\n// Lista básica de ofensas/golpe. Ajuste à vontade.\nconst ofensivo = /\\b(lixo|golpista|golpe|fraude|picaret\\w*|vagabund\\w*|idiota|otari\\w*|burr[oa]s?|merda|porra|caralh\\w*|fdp|puta|arrombad\\w*|desgra[cç]\\w*|ladr[aã]o|ladroes)\\b/i;\nconst spam = /(https?:\\/\\/|www\\.|ganhe dinheiro|renda extra|me chama no pv|pix|bit\\.ly|onlyfans)/i;\nconst saida = [];\n$input.all().forEach((it, i) => {\n  const palavra = posts[i]?.json.palavra || '';\n  for (const c of (it.json.data || [])) {\n    if (memoria.tratados[c.id]) continue;\n    memoria.tratados[c.id] = Date.now();\n    if (!c.text || c.username === cfg.usuario || c.hidden) continue;\n    if (ofensivo.test(c.text) || spam.test(c.text)) {\n      saida.push({ json: { acao: 'ocultar', commentId: c.id, username: c.username, texto: c.text } });\n    } else if (palavra && norm(c.text).includes(norm(palavra))) {\n      saida.push({ json: { acao: 'dm', commentId: c.id, username: c.username, palavra, texto: c.text } });\n    }\n  }\n});\n// Limpa a memória de comentários com mais de 30 dias\nconst velho = Date.now() - 30 * 24 * 3600 * 1000;\nfor (const [k, t] of Object.entries(memoria.tratados)) if (t < velho) delete memoria.tratados[k];\nreturn saida;"
      }
    },
    {
