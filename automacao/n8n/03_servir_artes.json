      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "4c259a00-d96c-4368-8e1e-19b5191b4ca9",
              "name": "chave",
              "value": "TROQUE_POR_UMA_SENHA_LONGA",
              "type": "string"
            },
            {
              "id": "4f87d7fe-0540-4ba7-921b-b986af2cd344",
              "name": "repo",
              "value": "eufvideos-lab/euforia-carrosseis",
